# Database
# For production, add connection pool params: ?connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://flowraze_user:your_password@localhost:5432/flowraze"

# Auth — generate a long random string for production (e.g. openssl rand -hex 32)
JWT_SECRET="change_me_before_deploying"

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (production only)
# ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# App URL — used to generate password reset links
# APP_URL="https://yourdomain.com"

# Midtrans Payment Provider
# Get keys from https://dashboard.midtrans.com (sandbox) or https://account.midtrans.com (production)
# MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxx"
# MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxx"
# MIDTRANS_MERCHANT_ID="G000000000"
# MIDTRANS_PRODUCTION="false"
