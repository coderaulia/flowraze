generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  password                 String
  name                     String
  role                     Role      @default(staff)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?   @unique
  passwordResetToken       String?   @unique
  passwordResetRequestedAt DateTime?
  passwordResetExpiresAt   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  leads                    Lead[]
  deals                    Deal[]
  activities               Activity[]
  apiKeys                  ApiKey[]
  webhookEndpoints         WebhookEndpoint[]
  campaigns                Campaign[] @relation("CampaignOwner")
  salesCampaigns           Campaign[] @relation("CampaignSalesOwner")
  managedTeams             SalesTeam[]        @relation("TeamManager")
  teamMemberships          SalesTeamMember[]
  salesTargets             SalesTarget[]
}

enum Role {
  superadmin
  admin
  staff
}

model Lead {
  id           String      @id @default(cuid())
  fullName     String
  email        String
  phone        String?
  companyName  String?
  source       String
  serviceType  String?
  campaignId   String?
  ownerId      String
  status       LeadStatus  @default(new)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner        User        @relation(fields: [ownerId], references: [id])
  campaign     Campaign?   @relation(fields: [campaignId], references: [id])
  deals        Deal[]
  activities   Activity[]
}

enum LeadStatus {
  new
  contacted
  qualified
  unqualified
}

model Deal {
  id                String      @id @default(cuid())
  leadId            String
  title             String
  value             Float
  stage             DealStage   @default(new)
  ownerId           String
  expectedCloseDate DateTime?
  closedAt          DateTime?
  status            DealStatus  @default(active)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lead              Lead        @relation(fields: [leadId], references: [id])
  owner             User        @relation(fields: [ownerId], references: [id])
}

enum DealStage {
  new
  qualified
  proposal
  negotiation
  won
  lost
}

enum DealStatus {
  active
  closed
}

model Campaign {
  id        String    @id @default(cuid())
  name      String
  type      String?
  channel   String
  cost      Float?
  startDate DateTime
  endDate   DateTime?
  ownerId   String?
  salesOwnerId String?
  createdAt DateTime  @default(now())

  owner     User?     @relation("CampaignOwner", fields: [ownerId], references: [id])
  salesOwner User?    @relation("CampaignSalesOwner", fields: [salesOwnerId], references: [id])
  leads     Lead[]
}

model Activity {
  id        String        @id @default(cuid())
  leadId    String
  type      ActivityType
  content   String
  createdBy String
  createdAt DateTime      @default(now())

  lead      Lead          @relation(fields: [leadId], references: [id])
  creator   User          @relation(fields: [createdBy], references: [id])
}

enum ActivityType {
  note
  call
  follow_up
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy   User      @relation(fields: [createdById], references: [id])
}

model WebhookEndpoint {
  id              String            @id @default(cuid())
  name            String
  url             String
  event           WebhookEvent
  secret          String
  isActive        Boolean           @default(true)
  createdById     String
  lastTriggeredAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  createdBy       User              @relation(fields: [createdById], references: [id])
  deliveries      WebhookDelivery[]
}

model WebhookDelivery {
  id              String          @id @default(cuid())
  endpointId      String
  event           WebhookEvent
  payload         Json
  status          WebhookStatus
  responseStatus  Int?
  error           String?
  retryCount      Int             @default(0)
  nextRetryAt     DateTime?
  createdAt       DateTime        @default(now())

  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

enum WebhookEvent {
  lead_created
  deal_created
  deal_won
  activity_created
}

enum WebhookStatus {
  pending
  success
  failed
}

model BillingAccount {
  id               String        @id @default(cuid())
  workspaceName    String        @default("FlowRaze Workspace")
  plan             PlanTier      @default(free)
  status           BillingStatus @default(trialing)
  seats            Int           @default(3)
  renewalDate      DateTime?
  externalCustomer String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

enum PlanTier {
  free
  growth
  pro
  custom
}

enum BillingStatus {
  trialing
  active
  past_due
  canceled
}

// ─── Sales Teams ────────────────────────────────────────────────────────────

model SalesTeam {
  id        String            @id @default(cuid())
  name      String
  managerId String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  manager   User              @relation("TeamManager", fields: [managerId], references: [id])
  members   SalesTeamMember[]
  targets   SalesTarget[]
}

model SalesTeamMember {
  teamId    String
  userId    String
  createdAt DateTime  @default(now())

  team      SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
}

// ─── Sales Targets ───────────────────────────────────────────────────────────

model SalesTarget {
  id            String       @id @default(cuid())
  name          String
  scope         TargetScope  @default(company)
  userId        String?      // set when scope = individual
  teamId        String?      // set when scope = team
  period        TargetPeriod
  year          Int
  quarter       Int?         // 1-4, set when period = quarterly
  month         Int?         // 1-12, set when period = monthly
  targetValue   Float        // revenue target in IDR
  targetLeads   Int?         // optional lead-count goal
  targetDeals   Int?         // optional deal-count goal
  category      String?      // maps to Campaign.type (null = all categories)
  shareOfParent Float?       // % of quarterly/annual target this period represents (0-100)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User?        @relation(fields: [userId], references: [id])
  team          SalesTeam?   @relation(fields: [teamId], references: [id])
}

enum TargetScope {
  company
  team
  individual
}

enum TargetPeriod {
  monthly
  quarterly
  yearly
}

