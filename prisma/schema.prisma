generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billing          BillingAccount?
  users            User[]
  leads            Lead[]
  deals            Deal[]
  campaigns        Campaign[]
  activities       Activity[]
  salesTeams       SalesTeam[]
  salesTargets     SalesTarget[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  automationRules  AutomationRule[]
  automationRuns   AutomationRun[]
  supportTickets   SupportTicket[]
  billingInvoices  BillingInvoice[]
  billingPayments  BillingPayment[]
}

model User {
  id                       String    @id @default(cuid())
  companyId                String?
  email                    String    @unique
  password                 String
  name                     String
  role                     Role      @default(employee)
  emailVerifiedAt          DateTime?
  emailVerificationToken   String?   @unique
  passwordResetToken       String?   @unique
  passwordResetRequestedAt DateTime?
  passwordResetExpiresAt   DateTime?
  inviteToken              String?   @unique
  inviteExpiresAt          DateTime?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  leads            Lead[]
  deals            Deal[]
  activities       Activity[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  automationRules  AutomationRule[]
  campaigns        Campaign[]        @relation("CampaignOwner")
  salesCampaigns   Campaign[]        @relation("CampaignSalesOwner")
  submittedSupportTickets SupportTicket[] @relation("SupportTicketRequester")
  assignedSupportTickets  SupportTicket[] @relation("SupportTicketAssignee")
  managedTeams     SalesTeam[]       @relation("TeamManager")
  teamMemberships  SalesTeamMember[]
  salesTargets     SalesTarget[]
  company          Company?          @relation(fields: [companyId], references: [id])
}

enum Role {
  superadmin
  admin
  manager
  employee
}

model Lead {
  id          String     @id @default(cuid())
  companyId   String
  fullName    String
  email       String
  phone       String?
  companyName String?
  source      String
  serviceType String?
  campaignId  String?
  ownerId     String
  status      LeadStatus @default(new)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id])
  campaign   Campaign?  @relation(fields: [campaignId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id])
  deals      Deal[]
  activities Activity[]

  @@unique([companyId, email])
}

enum LeadStatus {
  new
  contacted
  qualified
  unqualified
}

model Deal {
  id                String     @id @default(cuid())
  companyId         String
  leadId            String
  title             String
  value             Float
  stage             DealStage  @default(new)
  ownerId           String
  expectedCloseDate DateTime?
  closedAt          DateTime?
  status            DealStatus @default(active)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id])
  owner   User    @relation(fields: [ownerId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([leadId, title, ownerId])
}

enum DealStage {
  new
  qualified
  proposal
  negotiation
  won
  lost
}

enum DealStatus {
  active
  closed
}

model Campaign {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  type         String?
  channel      String
  cost         Float?
  startDate    DateTime
  endDate      DateTime?
  ownerId      String?
  salesOwnerId String?
  createdAt    DateTime  @default(now())

  owner      User?   @relation("CampaignOwner", fields: [ownerId], references: [id])
  salesOwner User?   @relation("CampaignSalesOwner", fields: [salesOwnerId], references: [id])
  company    Company @relation(fields: [companyId], references: [id])
  leads      Lead[]

  @@unique([companyId, name, channel, startDate])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  leadId    String
  type      ActivityType
  content   String
  createdBy String
  createdAt DateTime     @default(now())

  lead    Lead    @relation(fields: [leadId], references: [id])
  creator User    @relation(fields: [createdBy], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([leadId, type, content, createdBy])
}

enum ActivityType {
  note
  call
  follow_up
}

model ApiKey {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User    @relation(fields: [createdById], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
}

model WebhookEndpoint {
  id              String       @id @default(cuid())
  companyId       String
  name            String
  url             String
  event           WebhookEvent
  secret          String
  isActive        Boolean      @default(true)
  createdById     String
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy  User              @relation(fields: [createdById], references: [id])
  company    Company           @relation(fields: [companyId], references: [id])
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String        @id @default(cuid())
  endpointId     String
  event          WebhookEvent
  payload        Json
  status         WebhookStatus
  responseStatus Int?
  error          String?
  retryCount     Int           @default(0)
  nextRetryAt    DateTime?
  createdAt      DateTime      @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

enum WebhookEvent {
  lead_created
  deal_created
  deal_won
  activity_created
}

enum WebhookStatus {
  pending
  success
  failed
}

model AutomationRule {
  id              String                  @id @default(cuid())
  companyId       String
  name            String
  triggerEvent    AutomationTriggerEvent
  actionType      AutomationActionType
  actionConfig    Json
  isActive        Boolean                 @default(true)
  createdById     String
  lastTriggeredAt DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id])
  runs      AutomationRun[]

  @@unique([companyId, name])
}

model AutomationRun {
  id          String              @id @default(cuid())
  companyId   String
  ruleId      String
  triggerEvent AutomationTriggerEvent
  actionType  AutomationActionType
  payload     Json
  status      AutomationRunStatus @default(pending)
  result      Json?
  error       String?
  retryCount  Int                 @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule    AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

enum AutomationTriggerEvent {
  manual
  lead_created
  deal_created
  deal_won
  activity_created
}

enum AutomationActionType {
  create_activity
  update_lead_status
}

enum AutomationRunStatus {
  pending
  running
  success
  failed
}

model SupportTicket {
  id           String                @id @default(cuid())
  companyId    String
  requesterId  String
  assignedToId String?
  type         SupportTicketType
  priority     SupportTicketPriority @default(medium)
  status       SupportTicketStatus   @default(open)
  subject      String
  description  String
  pageUrl      String?
  browserInfo  String?
  slaDueAt     DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester User    @relation("SupportTicketRequester", fields: [requesterId], references: [id])
  assignedTo User?  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
}

enum SupportTicketType {
  bug
  question
  onboarding
  billing
  feature_request
}

enum SupportTicketPriority {
  low
  medium
  high
  urgent
}

enum SupportTicketStatus {
  open
  in_progress
  waiting_on_customer
  resolved
  closed
}

model BillingAccount {
  id                    String        @id @default(cuid())
  companyId             String        @unique
  workspaceName         String        @default("FlowRaze Workspace")
  plan                  PlanTier      @default(free)
  status                BillingStatus @default(trialing)
  seats                 Int           @default(3)
  billingCycle          BillingCycle  @default(monthly)
  renewalDate           DateTime?
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  canceledAt            DateTime?
  cancelReason          String?
  externalCustomer      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company  Company          @relation(fields: [companyId], references: [id])
  invoices BillingInvoice[]
  payments BillingPayment[]
}

enum PlanTier {
  free
  growth
  pro
  custom
}

enum BillingStatus {
  trialing
  active
  past_due
  canceled
}

enum BillingCycle {
  monthly
  annual
}

model BillingInvoice {
  id               String        @id @default(cuid())
  companyId        String
  billingAccountId String
  invoiceNumber    String        @unique
  amount           Float
  status           InvoiceStatus @default(open)
  dueDate          DateTime
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  billingAccount BillingAccount   @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  payments       BillingPayment[]
}

model BillingPayment {
  id               String        @id @default(cuid())
  companyId        String
  billingAccountId String
  invoiceId        String?
  amount           Float
  status           PaymentStatus @default(pending)
  method           String        @default("manual")
  reference        String?
  checkedAt        DateTime?
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  billingAccount BillingAccount  @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  invoice        BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

enum InvoiceStatus {
  open
  paid
  void
  overdue
}

enum PaymentStatus {
  pending
  paid
  rejected
  expired
}

// ─── Sales Teams ────────────────────────────────────────────────────────────

model SalesTeam {
  id        String   @id @default(cuid())
  companyId String
  name      String
  managerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager User              @relation("TeamManager", fields: [managerId], references: [id])
  company Company           @relation(fields: [companyId], references: [id])
  members SalesTeamMember[]
  targets SalesTarget[]

  @@unique([companyId, name])
}

model SalesTeamMember {
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
}

// ─── Sales Targets ───────────────────────────────────────────────────────────

model SalesTarget {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  scope         TargetScope  @default(company)
  userId        String? // set when scope = individual
  teamId        String? // set when scope = team
  period        TargetPeriod
  year          Int
  quarter       Int? // 1-4, set when period = quarterly
  month         Int? // 1-12, set when period = monthly
  targetValue   Float // revenue target in IDR
  targetLeads   Int? // optional lead-count goal
  targetDeals   Int? // optional deal-count goal
  category      String? // maps to Campaign.type (null = all categories)
  shareOfParent Float? // % of quarterly/annual target this period represents (0-100)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user    User?      @relation(fields: [userId], references: [id])
  team    SalesTeam? @relation(fields: [teamId], references: [id])
  company Company    @relation(fields: [companyId], references: [id])
}

enum TargetScope {
  company
  team
  individual
}

enum TargetPeriod {
  monthly
  quarterly
  yearly
}
